# Copy to .env next to docker-compose.yml (mode 640, never commit). Placeholders in <...>.

# image version to run — change only this line to roll forward or back
IMAGE_TAG=0.1.0

# host side of the read-only mounts
HPC_COLLECTOR_HOST_DIR=<existing one-minute collector output dir>
HPC_LEDGER_HOST_DIR=<read-only checkout of the approved production repository revision>
HPC_LEDGER_REV=<short commit id of that checkout, shown on the page>
HPC_MEDIA_HOST_DIR=<folder holding the approved preview media>
HPC_MEDIA_MANIFEST_HOST=<media list JSON, see deploy/README.md>
HPC_HOST_PORT=8097

# Host headers nginx forwards (comma separated); keep 127.0.0.1 for the container health check
HPC_ALLOWED_HOSTS=127.0.0.1,localhost,<server address>,<server name>

# report/media access — basic (default). Entries from: printf %s 'PASSWORD' | node scripts/hash-password.mjs <name>
HPC_AUTH=basic
HPC_USERS=<name>:scrypt:<salt>:<hash>

# private words to mask in report text (names, hosts) — comma separated, runtime only
HPC_REDACT_TERMS=<term1>,<term2>

# 1 = one JSON line per request in docker logs (method, path, status, ms)
HPC_ACCESS_LOG=0
