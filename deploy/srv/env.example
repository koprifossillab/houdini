# Copy to .env next to docker-compose.yml: install -m 640 /dev/null .env, then edit with an editor.
# Never commit. Placeholders in <...>. Secrets: see deploy/README.md §1 (no secret on a command line).

# image version to run — change only this line to roll forward or back
IMAGE_TAG=0.1.1

# host side of the read-only mounts
HPC_COLLECTOR_HOST_DIR=<existing one-minute collector output dir>
HPC_LEDGER_HOST_DIR=<read-only checkout of the approved production repository revision>
HPC_LEDGER_REV=<short commit id of that checkout, shown on the page>
HPC_MEDIA_HOST_DIR=<folder holding the approved preview media>
HPC_MEDIA_MANIFEST_HOST=<media list JSON, see deploy/README.md>
HPC_HOST_PORT=8097

# container network — fixed so the proxy's address inside the container is known
HPC_NET_SUBNET=<unused subnet, e.g. 10.197.97.0/29>
HPC_NET_GATEWAY=<its gateway, e.g. 10.197.97.1>

# Host headers nginx forwards (comma separated); keep 127.0.0.1 for the container health check
HPC_ALLOWED_HOSTS=127.0.0.1,localhost,<server address>,<server name>

# credentials — every view except /healthz needs them; entries from scripts/hash-password.mjs
HPC_USERS=<name>:scrypt:<salt>:<hash>
# shared secret nginx sends as X-HPC-Proxy-Token (same value in the nginx secrets include)
HPC_PROXY_TOKEN=<random, 32+ characters>

# private words to mask in report text (names, hosts) — comma separated, runtime only
HPC_REDACT_TERMS=<term1>,<term2>

# 1 = one JSON line per request (method, route id, status, ms) — never URLs, queries or headers
HPC_ACCESS_LOG=0
# team session collector output and signed Work events (0.1.6)
HPC_TEAM_LIVE_HOST_DIR=<team_live collector output dir>
HPC_WORK_ACTIVITY_HOST_DIR=<Work intake public output dir>
# 0.2.0 project board — all mounted read-only. An empty value stops compose; a value naming a folder that does not
# exist also stops it (create_host_path: false). Create the folders first (mode 755, files readable by others —
# the container user is uid 1000, not the folder owner).
HPC_HANDOFF_HOST_DIR=<handoff card folder with TC-PROD/ TC-QA/ TC-WORK/ TC-DASH/>
HPC_DECISIONS_HOST_DIR=<decision record folder written by ④>
HPC_NAS_FILM_HOST_DIR=<NAS film working folder>
HPC_NAS_LAUNCH_HOST_DIR=<NAS launcher folder>


# 0.4.2 (TC-DASH-012): Thermal Collapse LIVE — read-only folders on the host
#   published meshes: index.json (tc-live-frames/1) + fNNNN.bin (TCM1), only what the director allowed for viewing
HPC_TCLIVE_MESH_HOST_DIR=/path/to/tc_live_data/published
#   ① progress status files (tc-live-status/1), one per task and candidate
HPC_TCLIVE_STATUS_HOST_DIR=/path/to/tc_live/status
